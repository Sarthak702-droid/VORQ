{
  "name": "vorq",
  "version": "1.0.0",
  "description": "VORQ - Role-aware Construction Operations & Financial-Control Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:auth": "node --experimental-strip-types --test --test-isolation=none tests/auth-api.test.mjs",
    "test:auth:policy": "python3 -m unittest discover -s tests -v",
    "test:auth:live": "python3 tests/verify_auth_live.py",
    "test:architecture": "python3 -m unittest discover -s tests -p test_modular_architecture.py -v",
    "test:backend:live": "python3 tests/verify_modular_live.py",
    "test:http:live": "python3 tests/verify_modular_http.py",
    "test:mobile-proxy:live": "python3 tests/verify_mobile_proxy_live.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
