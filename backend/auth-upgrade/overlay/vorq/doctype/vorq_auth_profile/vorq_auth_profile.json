{
  "doctype": "DocType",
  "name": "VORQ Auth Profile",
  "module": "VORQ",
  "autoname": "hash",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "User",
      "unique": 1
    },
    {
      "fieldname": "totp_enabled",
      "label": "Totp Enabled",
      "fieldtype": "Check",
      "reqd": 0
    },
    {
      "fieldname": "totp_secret",
      "label": "Totp Secret",
      "fieldtype": "Password",
      "reqd": 0
    },
    {
      "fieldname": "last_counter",
      "label": "Last Counter",
      "fieldtype": "Int",
      "reqd": 0
    },
    {
      "fieldname": "recovery_hashes",
      "label": "Recovery Hashes",
      "fieldtype": "Code",
      "reqd": 0
    },
    {
      "fieldname": "requested_role",
      "label": "Requested Role",
      "fieldtype": "Select",
      "reqd": 0,
      "options": "Owner\nProject Manager\nQuantity Surveyor\nSite Engineer\nStorekeeper\nProcurement Officer\nAccountant\nSubcontractor"
    },
    {
      "fieldname": "company_name",
      "label": "Company Name",
      "fieldtype": "Data",
      "reqd": 0
    },
    {
      "fieldname": "role_details",
      "label": "Role Details",
      "fieldtype": "Code",
      "reqd": 0
    },
    {
      "fieldname": "access_status",
      "label": "Access Status",
      "fieldtype": "Select",
      "reqd": 0,
      "options": "Pending review\nExisting account"
    }
  ],
  "field_order": [
    "user",
    "totp_enabled",
    "totp_secret",
    "last_counter",
    "recovery_hashes",
    "requested_role",
    "company_name",
    "role_details",
    "access_status"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "report": 0
    }
  ],
  "track_changes": 0
}
